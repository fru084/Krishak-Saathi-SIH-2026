# Copy this file to .env.local and fill in the keys you have.
# The app works with none of these set — it just runs on demo/mock data.

# Plant.id / Kindwise crop health assessment (disease ID from a photo)
# Free tier signup: https://web.plant.id
PLANT_ID_API_KEY=

# Google Cloud — used for both translation (Cloud Translation API) and
# text-to-speech (Cloud Text-to-Speech API). Requires a GCP project with
# billing enabled and both APIs turned on, and a service account key
# downloaded as JSON. Put that file at .secrets/google-credentials.json
# (already gitignored) and point this at it:
GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-credentials.json

# No key needed for weather (Open-Meteo) or geocoding (OpenStreetMap).
